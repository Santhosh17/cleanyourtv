<?xml version="1.0" encoding="utf-8"?>
<!-- wifi_status_warnings: the Wi-Fi pill's icon while connected but not validated (no internet through the joined
     network, or a captive portal waiting for its login page), red like pill_icon_offline: red means no internet,
     whatever network is joined. Dark on the focused pill, as pill_icon_online. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:color="#FF111111" />
    <item android:color="#FFFF453A" />
</selector>
