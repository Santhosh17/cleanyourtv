    <string name="settings_section_weather" translatable="false">Weather</string>
    <string name="weather_cards_label" translatable="false">Weather cards</string>
    <string name="weather_cards_description" translatable="false">The weather cards above the dock on Home. Off hides both, and Home stops asking the Weather app for weather, so it goes online less. The country flag in the stats line keeps working.</string>
    <string name="weather_card1_label" translatable="false">First card</string>
    <string name="weather_card1_description" translatable="false">The first weather card, for the first card city. Off hides it and the second card moves into its place.</string>
    <string name="weather_card2_label" translatable="false">Second card</string>
    <string name="weather_card2_description" translatable="false">The second weather card, right of the first, for the second card city. Off hides it.</string>
    <string name="weather_needs_cards" translatable="false">Turn on Weather cards first</string>
    <string name="weather_needs_card" translatable="false">Turn on this card first</string>
    <string name="weather_city_label" translatable="false">First card city</string>
    <string name="weather_city_none" translatable="false">Not set</string>
    <string name="weather_city_description" translatable="false">The city for the weather above the dock on Home. Press OK to open the Weather app\'s city search; type a city and pick it. The Weather app fetches the forecast (from Open-Meteo, no account) at most every 30 minutes; the launcher itself stays offline.</string>
    <string name="weather_animation_label" translatable="false">Animated weather</string>
    <string name="weather_animation_description" translatable="false">Light effects on the weather cards that match each city\'s weather: a sun glow, twinkling stars, drifting clouds, rain, snow, lightning or mist. They run only while the cards are on Home. Turn them off if Home ever feels slow.</string>
    <string name="weather2_city_label" translatable="false">Second card city</string>
    <string name="weather2_city_description" translatable="false">A second weather reading right of the first one above the dock. Press OK, type a city in the Weather app\'s search and pick it; you come straight back here.</string>
