<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher settings in the Android TV Settings layout: grouped rows on the left, the focused row's options on the
     right. Rows are built in LauncherSettingsActivity. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#FF1F2025">

    <ScrollView
        android:id="@+id/listScroll"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.58"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="96dp"
            android:paddingEnd="48dp"
            android:paddingTop="48dp"
            android:paddingBottom="48dp">

            <TextView
                android:id="@+id/pageTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginBottom="12dp"
                android:text="@string/launcher_settings"
                android:textColor="#FFE8EAED"
                android:textSize="32sp" />
        </LinearLayout>
    </ScrollView>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.42"
        android:background="#FF26282C"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="48dp"
            android:paddingEnd="56dp"
            android:paddingTop="56dp"
            android:paddingBottom="48dp">

            <TextView
                android:id="@+id/paneTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:textColor="#FF9AA0A6"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/paneDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="3sp"
                android:textColor="#FF9AA0A6"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/paneOptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
